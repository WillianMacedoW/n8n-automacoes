# Copie para .env. O .env fica fora do git.

# Token esperado no header x-webhook-token do fluxo compra-aprovada
WEBHOOK_TOKEN=troque-por-um-token-de-teste

# Conta local do n8n de teste. A senha precisa de 8 caracteres, maiúscula e número.
N8N_TEST_OWNER_EMAIL=dono-teste@example.com
N8N_TEST_OWNER_PASSWORD=TroqueEstaSenha1

# Usadas ao importar os fluxos num n8n próprio. Nos testes, tests/n8n-local.mjs
# substitui estas variáveis pelo mock local e por chaves de teste.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
CRM_BASE_URL=https://crm.example.com
CRM_API_KEY=coloque-a-chave-aqui
WHATSAPP_BASE_URL=https://whatsapp.example.com
WHATSAPP_API_KEY=coloque-a-chave-aqui
ANTHROPIC_API_KEY=coloque-a-chave-aqui
ANTHROPIC_MODEL=claude-sonnet-5-5
