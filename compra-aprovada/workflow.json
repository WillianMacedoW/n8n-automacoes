    {
      "parameters": {
        "jsCode": "// Traduz o payload (formato inspirado em plataformas de pagamento) para um objeto interno.\nconst body = $input.first().json.body ?? {};\nconst data = body.data ?? {};\nconst comprador = data.buyer ?? {};\nconst compra = data.purchase ?? {};\n\n// Mapa de produto para plano. Ids fictícios.\nconst PLANOS = { 900001: 'mensal', 900002: 'anual' };\n\nfunction normalizarTelefone(bruto) {\n  let d = String(bruto ?? '').replace(/\\D/g, '').replace(/^00/, '');\n  if (d.length === 10 || d.length === 11) d = '55' + d; // veio sem DDI\n  // Celular antigo, sem o nono dígito\n  if (d.length === 12 && d.startsWith('55') && /[6-9]/.test(d[4])) d = d.slice(0, 4) + '9' + d.slice(4);\n  // Aceita só celular brasileiro: 55 + DDD + 9 + 8 dígitos\n  return /^55[1-9][1-9]9\\d{8}$/.test(d) ? d : null;\n}\n\nconst telefone = normalizarTelefone(comprador.checkout_phone);\nconst email = String(comprador.email ?? '').trim().toLowerCase();\nconst transacao = compra.transaction ?? null;\n\nreturn [{ json: {\n  payloadValido: Boolean(transacao && email.includes('@')),\n  chaveEvento: body.event + ':' + transacao,\n  transacao,\n  nome: String(comprador.name ?? '').trim(),\n  primeiroNome: String(comprador.name ?? '').trim().split(/\\s+/)[0] || 'tudo bem',\n  email,\n  telefone,\n  telefoneValido: telefone !== null,\n  produtoId: data.product?.id ?? null,\n  produto: data.product?.name ?? null,\n  plano: PLANOS[data.product?.id] ?? 'desconhecido',\n} }];"
      },
      "name": "Normalizar dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
