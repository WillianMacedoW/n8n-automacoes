    {
      "parameters": {
        "jsCode": "const pedido = $('Montar pedido').first().json;\nconst estado = $getWorkflowStaticData('global');\nconst vistos = estado.eventosProcessados ?? {};\nvistos[pedido.chaveEvento] = new Date().toISOString();\n\n// Mantém só os 1000 mais recentes para o static data não crescer sem limite.\nconst chaves = Object.keys(vistos);\nfor (const chave of chaves.slice(0, Math.max(0, chaves.length - 1000))) delete vistos[chave];\nestado.eventosProcessados = vistos;\n\nreturn [{ json: {\n  status: pedido.telefoneValido ? 'processado' : 'processado_sem_whatsapp',\n  transacao: pedido.transacao,\n  plano: pedido.plano,\n  whatsapp: pedido.telefoneValido ? 'enviado' : 'nao_enviado',\n  motivo: pedido.telefoneValido ? null : 'telefone_invalido',\n} }];"
      },
